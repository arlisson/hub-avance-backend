    {
      "parameters": {
        "jsCode": "const key = $input.first().json.master_key_transito || \"\";\nconst crypto = require('crypto');\n\nreturn $input.all().map(item => {\n  try {\n    // 1. Busca o valor com segurança (o '?.' evita quebrar se o 'body' não existir)\n    const text = $('Webhook').first().json.body?.chave_gemini_recebida;\n    \n    // 2. Valida se o texto realmente chegou antes de tentar criptografar\n    if (!text) {\n      throw new Error(\"O campo 'chave_gemini_recebida' não foi encontrado no payload do Webhook.\");\n    }\n\n    const iv = crypto.randomBytes(16);\n    // Nota: Como você usa aes-256-cbc, a chave de trânsito precisa ter exatamente 32 caracteres.\n    const cipher = crypto.createCipheriv('aes-256-cbc', key, iv);\n    \n    let encrypted = cipher.update(text, 'utf8', 'hex');\n    encrypted += cipher.final('hex');\n    \n    item.json.encrypted_key = iv.toString('hex') + ':' + encrypted;\n  } catch (e) {\n    item.json.error = e.message;\n  }\n  return item;\n});"
      },
